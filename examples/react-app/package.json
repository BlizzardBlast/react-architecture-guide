{
  "name": "react-architecture-reference-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run arch && tsc --noEmit && vite build --outDir ../../.vite-build/react-app --emptyOutDir",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "arch": "node ../../tools/check-boundaries.cjs src",
    "verify": "npm run lint && npm test && npm run build",
    "lint": "eslint src vite.config.ts vitest.setup.ts",
    "preview": "vite preview --outDir ../../.vite-build/react-app"
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.21",
    "@tanstack/react-router": "1.170.38",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "typescript-eslint": "8.71.1"
  }
}
